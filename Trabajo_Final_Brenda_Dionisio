                    wedgeprops=dict(width=0.4, edgecolor='white'))
            eje.set_title('REPARTICION PROPORCIONAL DE LOS ESPACIOS', fontweight='bold', color='#4A2E35')
            
        elif modalidad == 'lineal':
            # 4. CAMBIO: Gráfico de Área Suavizada con relleno inferior
