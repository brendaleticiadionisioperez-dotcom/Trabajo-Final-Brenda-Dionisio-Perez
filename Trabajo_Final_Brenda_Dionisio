    def construir_grafica_exclusiva(archivo_salida, modalidad):
        fig, eje = plt.subplots(figsize=(8.0, 3.4))
        eje.set_facecolor('#FDFBFB')
        fig.patch.set_facecolor('white')
        
        if modalidad == 'histograma':
            # 1. CAMBIO: Gráfico de Densidad Suavizado (KDE) en lugar de histograma común
            try:
                kde = stats.gaussian_kde(registros_financieros)
                valores_x = np.linspace(registros_financieros.min(), registros_financieros.max(), 200)
                eje.plot(valores_x, kde(valores_x), color='#4A2E35', linewidth=2)
                eje.fill_between(valores_x, kde(valores_x), color='#D9C3C7', alpha=0.6)
            except:
                eje.hist(registros_financieros, bins=30, color='#A87B85', alpha=0.7)
            eje.set_title('PERFIL DE DENSIDAD CONTINUA DE LOS FLUJOS', fontweight='bold', color='#4A2E35')
            
        elif modalidad == 'caja':
            # 2. CAMBIO: Gráfico de Violín en lugar del diagrama de caja clásico
            partes = eje.violinplot(registros_financieros, vert=False, showmeans=True, showmedians=True)
            for pc in partes['bodies']:
                pc.set_facecolor('#A87B85')
                pc.set_edgecolor('#4A2E35')
                pc.set_alpha(0.6)
            partes['cmeans'].set_color('#4A2E35')
            partes['cmedians'].set_color('#8C5B66')
            eje.set_title('CURVATURA DE DISPERSION Y VOLATILIDAD MUESTRAL', fontweight='bold', color='#4A2E35')
            eje.set_yticks([])
            
        elif modalidad == 'barras':
            # 3. CAMBIO: Gráfico de Dona Ejecutiva en lugar de barras simples
