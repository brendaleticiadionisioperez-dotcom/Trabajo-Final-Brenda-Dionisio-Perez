            eje.set_title('LINEA DE TRAYECTORIA ACUMULATIVA DE VALOR', fontweight='bold', color='#4A2E35')
        
        eje.grid(True, linestyle=':', alpha=0.4, color='#D2C4C6')
        plt.tight_layout()
