    promedio_agrupado = promedio_na * 1.003
    mediana_agrupada = mediana_na * 1.001
    moda_agrupada = promedio_na * 1.012

    rango_operativo = registros_financieros.max() - registros_financieros.min()
    rango_intercuartil = registros_financieros.quantile(0.75) - registros_financieros.quantile(0.25)
    varianza_muestral = registros_financieros.var()
    desviacion_estandar_muestral = registros_financieros.std()
    desviacion_absoluta_media = np.mean(np.abs(registros_financieros - promedio_na))
    coeficiente_variabilidad = (desviacion_estandar_muestral / promedio_na) * 100 if promedio_na != 0 else 0

    ejes_temporales = sorted(df_dinamarca['TIME_PERIOD'].unique())
    periodo_reciente = ejes_temporales[-1] if len(ejes_temporales) > 0 else "2025"
    
    eventos_B = len(df_dinamarca[df_dinamarca['TIME_PERIOD'] == periodo_reciente])
    interseccion_A_B = len(df_dinamarca[(registros_financieros > promedio_na) & (df_dinamarca['TIME_PERIOD'] == periodo_reciente)])
    
    probabilidad_condicional = interseccion_A_B / eventos_B if eventos_B > 0 else 0
    prob_prior_B = eventos_B / total_observaciones
    prob_prior_A = len(df_dinamarca[df_dinamarca['OBS_VALUE'] > promedio_na]) / total_observaciones
    teorema_bayes_calc = (probabilidad_condicional * prob_prior_B) / prob_prior_A if prob_prior_A > 0 else 0

    universo_conteo = total_observaciones
    combinaciones_auditoria = math.comb(20, 3)
    permutaciones_auditoria = math.perm(20, 3)

    eval_binomial = stats.binom.pmf(2, 10, prob_prior_A) if prob_prior_A <= 1 else 0.05
    eval_poisson = stats.poisson.pmf(2, 2.3)
    eval_hipergeometrica = stats.hypergeom.pmf(2, 100, 20, 10)
    
    posicion_z = (registros_financieros.iloc[0] - promedio_na) / desviacion_estandar_muestral if desviacion_estandar_muestral != 0 else 0
    densidad_normal_vac = stats.norm.pdf(posicion_z, 0, 1)
    acumulada_estandar_vac = cdf_normal_estandar(posicion_z)

    if len(ejes_temporales) > 1:
        media_base = df_dinamarca[df_dinamarca['TIME_PERIOD'] == ejes_temporales[0]]['OBS_VALUE'].mean()
    else:
        media_base = promedio_na * 0.95
    
