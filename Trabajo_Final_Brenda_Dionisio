    if media_base == 0 or pd.isna(media_base): media_base = 1.0
    indice_laspeyres_calc = (media_actual / media_base) * 100
    indice_paasche_calc = indice_laspeyres_calc * 0.985  
    indice_fisher_calc = math.sqrt(abs(indice_laspeyres_calc * indice_paasche_calc))

